{
  "name": "dsh-postapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostAPI plugin for DeepSeek Harness",
  "scripts": {
    "build": "node build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
